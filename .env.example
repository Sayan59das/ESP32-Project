SOURCE=sim
# Blank = auto-detect (Arduino first, then CP210x, CH340, FTDI).
SERIAL_PORT=
# Never 1200: that is the Arduino signal to reboot the board into its bootloader.
BAUD=115200
DB_PATH=./ecosort.db
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000
# The console sends nothing anywhere: no Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
# Used when SOURCE=replay. Defaults to data/sample_session.rec.
# REPLAY_FILE=data/sample_session.rec
